DISCORD_TOKEN=
# Use a persistent Railway volume for production, e.g. /data/nuggetbot.sqlite3.
# If RAILWAY_VOLUME_MOUNT_PATH exists, the bot uses that automatically.
DATABASE_PATH=

# Optional: sync slash commands to a single guild while developing.
# GUILD_ID=

# Optional: OpenAI-compatible endpoint for the Imposter cog.
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini

# Optional web dashboard. Railway provides PORT automatically.
DASHBOARD_ENABLED=true
DASHBOARD_TOKEN=
# DASHBOARD_HOST=0.0.0.0
# DASHBOARD_PORT=8080
