DISCORD_TOKEN=
# Prefer DATABASE_URL for Railway PostgreSQL production storage.
DATABASE_URL=
# Optional fallback if Railway internal database DNS is unavailable to this service.
DATABASE_PUBLIC_URL=
# Railway safety: SQLite is refused on Railway unless this is true.
ALLOW_SQLITE_ON_RAILWAY=false
# SQLite fallback: use a persistent Railway volume, e.g. /data/goonbot.sqlite3.
DATABASE_PATH=

# Velvet Vixen portraits: glam | armored | both (random). Default both.
# VELVET_VIXEN_ART_STYLE=both

# Optional: sync slash commands to a single guild while developing.
# GUILD_ID=

# Leave unset / false. GoonBot will not DM players.
# DM_NOTIFICATIONS_ENABLED=false

# Optional: OpenAI-compatible endpoint for the Imposter cog and avatar generation.
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
# Unique default avatars: set AVATAR_AI_GENERATION=true to use the images API when AI_API_KEY is set.
AVATAR_AI_GENERATION=true
# AVATAR_IMAGE_API_URL=https://api.openai.com/v1/images/generations
# AVATAR_IMAGE_MODEL=dall-e-3
# AVATAR_IMAGE_SIZE=1024x1024

# Optional web dashboard. Railway provides PORT automatically.
DASHBOARD_ENABLED=true
DASHBOARD_TOKEN=
# DASHBOARD_HOST=0.0.0.0
# DASHBOARD_PORT=8080

# Dangerous one-time job: leave disabled unless intentionally running launch grant.
LAUNCH_GRANT_ENABLED=false
